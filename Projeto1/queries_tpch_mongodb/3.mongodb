// db.orders.aggregate([...])
[
  {
    $match: {
      "customer.mktsegment": "BUILDING",
      order_date: { $lt: ISODate("1995-03-15T00:00:00Z") },
      "line_items.ship_date": { $gt: ISODate("1995-03-15T00:00:00Z") }
    }
  },
  {
    $project: {
      _id: 0,
      l_orderkey: "$_id",
      o_orderdate: "$order_date",
      o_shippriority: "$ship_priority",
      revenue: {
        $sum: {
          $map: {
            input: {
              $filter: {
                input: "$line_items",
                as: "item",
                cond: { $gt: ["$$item.ship_date", ISODate("1995-03-15T00:00:00Z")] }
              }
            },
            as: "i",
            in: {
              $multiply: ["$$i.extended_price", { $subtract: [1, "$$i.discount"] }]
            }
          }
        }
      }
    }
  },
  {
    $sort: {
      revenue: -1,
      o_orderdate: 1
    }
  },
  { $limit: 10 }
],
{ allowDiskUse: true, hint: { $natural: 1 } }

// ===================================

// db.lineitems_plus.aggregate([...])
[
  {
    $match: {
      "order.customer_mktsegment": "BUILDING",
      "order.order_date": { $lt: ISODate("1995-03-15T00:00:00Z") },
      ship_date: { $gt: ISODate("1995-03-15T00:00:00Z") }
    }
  },
  {
    $group: {
      _id: "$orderkey",
      revenue: {
        $sum: {
          $multiply: ["$extended_price", { $subtract: [1, "$discount"] }]
        }
      },
      o_orderdate: { $first: "$order.order_date" },
      o_shippriority: { $first: "$order.ship_priority" }
    }
  },
  {
    $project: {
      _id: 0,
      l_orderkey: "$_id",
      revenue: 1,
      o_orderdate: 1,
      o_shippriority: 1
    }
  },
  {
    $sort: {
      revenue: -1,
      o_orderdate: 1
    }
  },
  { $limit: 10 }
],
{
  allowDiskUse: true,
  hint: { "order.customer_mktsegment": 1, "order.order_date": 1, "ship_date": 1 }
}
